#include <Servo.h>

// Pin Config
const int ldrPin = A0;       // Photoresistor
const int ledPin = 5;        // LED
const int buttonPin = 6;     // Push button
const int buzzerPin = 7;     // Piezo buzzer
const int servoPin = 8;      // Servo motor
const int soundSensor = A1;  // Sound sensor (analog)

// Servo
Servo cradleServo;
int lightThreshold = 500;    // Adjust for your environment
int soundThreshold = 1050;    // Adjust for baby crying detection

// Twinkle Twinkle Notes
#define NOTE_C4 262
#define NOTE_D4 294
#define NOTE_E4 330
#define NOTE_F4 349
#define NOTE_G4 392
#define NOTE_A4 440
#define NOTE_B4 494
#define NOTE_C5 523

int melody[] = {
  NOTE_C4, NOTE_C4, NOTE_G4, NOTE_G4, NOTE_A4, NOTE_A4, NOTE_G4,
  NOTE_F4, NOTE_F4, NOTE_E4, NOTE_E4, NOTE_D4, NOTE_D4, NOTE_C4
};

int noteDurations[] = {
  4, 4, 4, 4, 4, 4, 2,
  4, 4, 4, 4, 4, 4, 2
};

// ------------------- SETUP -------------------
void setup() {
  pinMode(buttonPin, INPUT_PULLUP); // button active LOW
  pinMode(buzzerPin, OUTPUT);
  pinMode(ledPin, OUTPUT);

  cradleServo.attach(servoPin);
  cradleServo.write(90); // neutral position

  Serial.begin(9600);
  Serial.println("System Initialized...");
}

// ------------------- MAIN LOOP -------------------
void loop() {
  int ldrValue = analogRead(ldrPin);
  int buttonState = digitalRead(buttonPin); // HIGH = not pressed
  int soundValue = analogRead(soundSensor);

  // Print sensor readings
  Serial.print("LDR: ");
  Serial.print(ldrValue);
  Serial.print(" | Button: ");
  Serial.print(buttonState == LOW ? "NOT PRESSED" : "PRESSED");
  Serial.print(" | Sound: ");
  Serial.println(soundValue);

  // 0. Bright room → everything stops IMMEDIATELY
  if (ldrValue >= lightThreshold) {
    stopAll();
    return; // exit loop early so nothing else runs
  }

  // 1. Button HIGH → crying sound + swing (LED ON)
  if (buttonState == HIGH) {
    babyCryingSound();
    digitalWrite(ledPin, HIGH);
    swingSmooth();
  }
  // 2. Baby crying detected (regardless of light) → swing + LED blinks rapidly
  else if (soundValue > soundThreshold) {
    ledBlink();
    swingSmooth();
  }
  // 3. Button LOW → Full Twinkle Twinkle + swing
  else if (buttonState == LOW) {
    playTwinkleWithSwing();
  }
}


// ------------------- FUNCTIONS -------------------

// Baby crying sound
void babyCryingSound() {
  for (int i = 400; i <= 600; i += 20) {
    tone(buzzerPin, i);
    delay(15);
  }
  for (int i = 600; i >= 400; i -= 20) {
    tone(buzzerPin, i);
    delay(15);
  }
  noTone(buzzerPin);
  delay(100);
}

// Smooth swing (medium range for crying/button)
void swingSmooth() {
  for (int angle = 70; angle <= 110; angle += 3) {
    cradleServo.write(angle);
    delay(15);
  }
  for (int angle = 110; angle >= 70; angle -= 3) {
    cradleServo.write(angle);
    delay(15);
  }
}

// LED blink (fast for crying)
void ledBlink() {
  digitalWrite(ledPin, HIGH);
  delay(100);
  digitalWrite(ledPin, LOW);
  delay(100);
}

// Stop everything (for bright room)
void stopAll() {
  digitalWrite(ledPin, LOW);
  noTone(buzzerPin);
  cradleServo.write(90); // neutral stop
}

// Twinkle Twinkle with wide smooth swing
void playTwinkleWithSwing() {
  int notesCount = sizeof(melody) / sizeof(melody[0]);

  for (int i = 0; i < notesCount; i++) {
    int duration = 1000 / noteDurations[i];
    tone(buzzerPin, melody[i]);

    // Wide smooth swing (60°–120° slowly)
    for (int angle = 60; angle <= 120; angle += 2) {
      cradleServo.write(angle);
      delay(duration / 30);
    }
    for (int angle = 120; angle >= 60; angle -= 2) {
      cradleServo.write(angle);
      delay(duration / 30);
    }

    noTone(buzzerPin);
    delay(50); // short gap between notes

    // Re-check conditions mid-song
    int ldrValue = analogRead(ldrPin);
    int soundValue = analogRead(soundSensor);

    if (soundValue > soundThreshold || ldrValue >= lightThreshold) {
      stopAll();
      return;
    }
  }
}

